    <string name="about_title">About and data</string>
    <string name="about_how_title">How it works</string>
    <string name="about_how_text">The app computes everything on the phone: from the weather (Open-Meteo), terrain height and a habitat map it scores every pixel (~250 m). Score = habitat × season × weather trigger. There is no server and nothing to configure.</string>
    <string name="about_data_title">Data</string>
    <string name="about_data_text">Weather: Open-Meteo.com (forecast and ERA5 reanalysis, 120 points over Slovenia). The forecast is refreshed at most every 3 hours, history is cached permanently. Finds: GBIF/iNaturalist and other sources.</string>
    <string name="about_model_created">Model built: %1$s</string>
