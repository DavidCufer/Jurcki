    <string name="about_cache_help">After clearing, the weather is downloaded again the next time a map is shown.</string>
    <string name="about_weather_attribution">Weather data by Open-Meteo.com (CC BY 4.0). ERA5: Copernicus Climate Change Service / ECMWF.</string>
